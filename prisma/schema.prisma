generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LogLevel {
  debug
  info
  warn
  error
}

model Log {
  id         String   @db.Uuid
  timestamp  DateTime
  level      LogLevel
  service    String
  message    String
  attributes Json
  createdAt  DateTime @default(now())

  @@id([timestamp, id])
}

model LogRollup {
  bucket  DateTime
  service String
  level   LogLevel
  count   BigInt

  @@id([bucket, service, level])
}

model LogSecondRollup {
  bucket  DateTime
  service String
  level   LogLevel
  count   BigInt

  @@id([bucket, service, level])
}
